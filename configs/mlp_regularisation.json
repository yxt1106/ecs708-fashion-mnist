{
  "model": {
    "hidden_sizes": [256, 128],
    "num_classes": 10
  },

  "training": {
    "seeds": [45, 46, 47],
    "batch_size": 128,
    "evaluation_batch_size": 256,
    "epochs": 20,
    "learning_rate": 0.001,
    "optimizer": "Adam",
    "loss": "CrossEntropyLoss"
  },

  "configurations": {
    "No regularisation": {
      "dropout_p": 0.0,
      "l2_lambda": 0.0
    },

    "Dropout": {
      "dropout_p": 0.3,
      "l2_lambda": 0.0
    },

    "L2": {
      "dropout_p": 0.0,
      "l2_lambda": 0.0001
    }
  },

  "checkpoint_metric": "validation_loss",
  "early_stopping": false
}
